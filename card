#!/usr/bin/env bash


function card_value() {
    local card=$1
    local card_value=${card:0:-1}
    case $card_value in
	    [[:digit:]]*)
	    echo "$card_value"
	    ;;
    	"A")
	    # Ace can be 1 or 11 
	    echo "11"
	    ;;
    	"J"|"Q"|"K")
	    echo "10"
	    ;;
	*)
	    echo "What kind of deck are you using"
	    ;;
    esac
}

function hand_total() {
	local hand=( "$@" )
	local total=0
	for card in "${hand[@]}"; do
		local curr_value=$(card_value $card) 
		local total=$(($total + $curr_value))
	done
	echo "$total"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Running test code"
    declare -a arr=("AD" "7S" "10D" "KH")
    echo "Full hand: ${arr[@]}"
    total=$(hand_total "${arr[@]}")
    echo "actual total: $total"
    card_value AD
    card_value 7S
    card_value 10D
    card_value KH
    card_value 2H
fi
