#!/usr/bin/env bash

. ./deck
. ./card

# Constants
NUM_OF_DECKS=1

echo "Running BashJack"

echo "Building deck"

deck=$(draw_deck $NUM_OF_DECKS)

while true; do
	printf 'Action: '
	read -r res
	card=$(echo $res | deck_input "${deck[@]}")
	echo "You drew $card"
	card_val=$(card_value $card)
	echo "That card has a blackjack value of $card_val"
done

