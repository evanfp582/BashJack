#!/usr/bin/env bash

. ./deck
. ./card
. ./helper
. ./UI

# Constants
NUM_OF_DECKS=2

function end_logic() {
	# I am taking the return code to mean if the code failed to run
	# But rather the result of the end 
	# 2 	= player wins
	# 3 	= dealer wins
	# 4 	= push
	# 21	= blackjack win (we have fun here)
	# I could do it a different way, but this will help me learn some bash things
	local -n player_hand_ref=$1	
	local -n dealer_hand_ref=$2
	debug "Player hand ${player_hand_ref[@]}"
	debug "Dealer hand ${dealer_hand_ref[@]}"	
	local player_total=$(hand_total "${player_hand_ref[@]}")
	local dealer_total=$(hand_total "${dealer_hand_ref[@]}")

	# Special logic if there is a blackjack involved
	local player_bj=$(is_blackjack "${player_hand_ref[@]}")
	local dealer_bj=$(is_blackjack "${dealer_hand_ref[@]}")

	local return_code
	local message

	# Making it 1 string so I can use a CASE statement rather than a nest of if else
	local concat="${player_bj}${dealer_bj}"
	debug "Concatinated player_blackjack dealer_blackjack results: $concat"
	case $concat in 
		"truetrue")
			message="Both blackjack, push"
			return_code=4
			;;
		"truefalse")
			message="You got blackjack, dealer does not"
			return_code=21
			;;
		"falsetrue")
			message="Dealer has blackjack, you do not"
			return_code=3
			;;
		"falsefalse")
			# Nothing special here
			;;
	esac


	if [[ -n $return_code ]]; then
		if [[ -n $UI ]]; then
			draw_message "$message"
		fi
		return $return_code
	fi
	
	#echo "player_total: $player_total"
	#echo "dealer_total: $dealer_total"
	
	debug "Totals: \n\tPlayer: $player_total \n\tDealer: $dealer_total"


	if [[ $player_total -gt 21 ]]; then
		message="Player busted, dealer wins"
		return_code=3
	elif [[ $dealer_total -gt 21 ]]; then
		message="Dealer busted, player wins"
		return_code=2
	elif [[ $player_total == $dealer_total ]]; then
		message="Draw, it is a push"
		return_code=4
	elif [[ $player_total -gt $dealer_total ]]; then
		message="Player wins!"
		return_code=2
	elif [[ $player_total -lt $dealer_total ]]; then
		message="Dealer wins :("
		return_code=3
	else
		message="Something went wrong"
		return_code=1
	fi	

	if [[ -n $UI ]]; then
		draw_message "$message"
	else
		echo "$message"
	fi
	return $return_code

}

function initial_deal() {
	local -n deck_ref=$1

	local -n dealer_hand_ref=$2
	local -n player_hand_ref=$3
	
	draw deck player_card_1_ref
	draw deck dealer_card_1_ref
	draw deck player_card_2_ref
	draw deck dealer_card_2_ref

	dealer_hand=( $dealer_card_1_ref $dealer_card_2_ref )
	player_hand=( $player_card_1_ref $player_card_2_ref )
}

function dealer_draw() {
	local -n deck_ref=$1
	local -n dealer_hand_ref=$2
	local dealer_hand_arr=("${dealer_hand_ref[@]}")

	if [[ -n $UI ]]; then
		print_hand "dealer" "${dealer_hand_arr[@]}"
	else
		debug "Dealer reveals their card, they have a ${dealer_hand_arr[0]}"
	fi
	
	sleep 1
	local dealer_total=$(hand_total "${dealer_hand_arr[@]}")
	while [ $dealer_total -le 16 ]; do

		if [[ -z "${deck_ref[@]}" ]]; then
			if [[ -n $UI ]]; then
 				erase_deck_back
				draw_message "Shuffling deck"
				draw_deck_back
			fi
			debug "deck is empty"
			deck_ref=( $(draw_deck $NUM_OF_DECKS) )
		fi
		sleep 1

		local new_card="${deck_ref[0]}"
		deck_ref=( "${deck_ref[@]:1}" )
		
		dealer_hand_arr+=($new_card)
		
		if [[ -n $UI ]]; then
			print_hand "dealer" "${dealer_hand_arr[@]}"
		else
			echo "Dealer drew: $new_card"
		fi
		
		local dealer_total=$(hand_total "${dealer_hand_arr[@]}")
	done
	debug "Dealer total: $dealer_total"
	debug "deck_ref at this point ${deck_ref[@]}"
	dealer_hand_ref=("${dealer_hand_arr[@]}")
}




function game() {
	local -n deck_ref=$1
	local deck=( "${deck_ref[@]}" )
	local stop_draw="false"
	debug "deck before drawing: ${deck[@]}"

	if [[ "${#deck[@]}" -lt 4 ]]; then
		if [[ -n $UI ]]; then
 			erase_deck_back
			draw_message "Shuffling deck"
			draw_deck_back
		fi
		debug "deck is empty"
		deck=( $(draw_deck $NUM_OF_DECKS) )
	fi

	
	initial_deal deck dealer_hand player_hand

	local player_hand=(${player_hand[@]})
	local dealer_hand=(${dealer_hand[@]})

	if [[ -n $UI ]]; then

		(print_hand "player" "${player_hand[@]}")
		local hidden_dealer=( "??" ${dealer_hand[1]} )
		(print_hand "dealer" "${hidden_dealer[@]}")
		
	else
		echo "Dealer has ${dealer_hand[1]} showing"
		echo "You have ${player_hand[@]}"
	fi

	while true; do
		debug "Current deck: ${deck[@]}"
		if [[ -z "${deck[@]}" ]]; then
			if [[ -n $UI ]]; then
 				erase_deck_back
				draw_message "Shuffling deck"
				draw_deck_back
			fi
			debug "deck is empty"
			deck=( $(draw_deck $NUM_OF_DECKS) )
		fi
		if [[ $stop_draw == "false" ]]; then
			
			
			if [[ -n $UI ]]; then
				draw_input "Action"
			else
				printf 'Action: '
			fi
			
			local total=0
			read -r response;
		else
			response="stand"
		fi
		case $response in
			"hit"|"h"|"draw"|"d"|"y"|"yes")
				draw deck card
				local player_hand+=($card)
				
				if [[ -n $UI ]]; then
					print_hand "player" "${player_hand[@]}"
				else
					echo "Player hand = ${player_hand[@]}"
				fi
				
				local total=$(hand_total "${player_hand[@]}")
				if [[ $total -gt 21 ]]; then
					debug "You have busted with a value of $total"
					local stop_draw="true"
				fi
				;;
			"double"|"dub"|"w")
				debug "Attempting to double your bet and only get 1 more card"
				# Must only have 2 cards in your hand
				if [[ "${#player_hand[@]}" == 2 ]]; then
					local new_bank=$(( $bank - $bet_amount )) 
					debug "Attempting to set new bet amount in double"
					if [[ $new_bank -ge 0 ]]; then
						bank=$new_bank
						bet_amount=$(( $bet_amount * 2 ))
						debug "Set bank to $bank and bet_amount to $bet_amount"

						draw deck card
						local player_hand+=($card)
						if [[ -n $UI ]]; then
		                                        print_hand "player" "${player_hand[@]}"
		                                else
		                                        echo "Player hand = ${player_hand[@]}"
		                                fi

						local stop_draw="true"

					else
						if [[ -n $UI ]]; then
							draw_message "You do not have enough money to double"
						else
							echo "You do not have enough money to double"
						fi
					fi
				else
					if [[-n $UI]]; then
						draw_message "You can only double when you have 2 cards"
					else
						echo "You can only double when you have 2 cards"
					fi
				fi	
				;;
			"stand"|"stop"|"s")
				local total=$(hand_total "${player_hand[@]}")
				debug "You are standing with a value of $total"
				
				dealer_draw deck dealer_hand
				local dealer_total=$(hand_total "${dealer_hand[@]}")
				end_logic player_hand dealer_hand
				local game_result=$?
				
				deck_ref=( "${deck[@]}" )

				# 2=player win; 3=dealer win; 4=push; 21=blackjack win 
				return $game_result
				
			i	;;
			"q"|"quit"|"exit")
				echo "leaving the program"
				return 0
				;;
			
			"split")
				if [[ -n $UI ]]; then
					draw_message "Not allowed to split since this is a 2 deck blackjack format (I did not program it in yet)"
				else
					echo "Not allowed to split since this is a 2 deck blackjack format (I did not program it in yet)"
				fi
				;;

			"insurance")
				local message="We do not do that here. That is a losing strategy (I did not program it in)"
				if [[ -n $UI ]]; then
					draw_message "$message"
				else
					echo "$message"
				fi
				;;
			"rules"|"rule")
				local message="2 Decks. Dealer stands on soft 17. 3-2 Blackjack payout!"

				if [[ -n $UI ]]; then
					draw_message "$message"
				else
					echo "$message"
				fi
				;;

			*)
				if [[ -n $UI ]]; then
					draw_message "Not a valid command. 's' or 'stand' to stand. 'h', 'hit', or 'draw' to get another card. 'double' or 'dub' to double"
				else
					printf "Valid command not found\n'hit' or 'h' to add a card\n'double' or 'dub' to double your bet and get only 1 more card\n'stand' or 's' to stand\n'quit' or 'q' to quit the program\n"
				fi
		esac
	done

	debug "Setting deck_ref to deck 2"	
	deck_ref=( "${deck[@]}" )
	return 0

}

function get_bet() {
	local -n amount_ref=$2
	local -n bank_ref=$1
	while true; do
		if [[ -n $UI ]]; then
			draw_input "Bet"
		else
			printf "Input valid bet: "
		fi
		read -r amount_ref;
		if [[ $amount_ref -gt $bank_ref ]]; then
			if [[ -n $UI ]]; then
				draw_message "Bet too large"
			else
				echo "Bet too large"
			fi
		elif [[ $amount_ref -lt 0 ]];then
			if [[ -n $UI ]]; then
				draw_message "Bet can't be negative"
			else
				echo "Bet can't be negative"
			fi
		
		elif [[ $amount_ref =~ ^[0-9]+$ ]]; then
			
			if [[ -n $UI ]]; then
				clear_input "Action"
			fi
			bank_ref=$(( $bank_ref-$amount_ref ))
			return 0
		else
			local message="Use a valid number"
			if [[ -n $UI ]]; then
				draw_message "$message"
			else
				echo "$message"
			fi	
		fi	
	done
}

function payout() {
	local -n bank_ref=$1
	local -n bet=$2
	local -n game_result_ref=$3

	case $game_result_ref in
		2)
			#echo "Player won"
			bank_ref=$(($bank_ref + ($bet * 2)))
			;;
		3)
			#echo "Dealer won"
			;;
		4)
			#echo "Push"
			bank_ref=$(($bank_ref + $bet))
			;;
		21)
			#Winning blackjack hand
			local new_winnings=$((($bet * 2) + $bet / 2))
			bank_ref=$(($bank_ref + $new_winnings))
			;;
		*)
			debug "There was an error somewhere"
			return 1
			;;
	esac
	return 0
}

function main() {
	if [[ -n $DEBUG ]]; then
		echo "--RUNNING IN DEBUG MODE--"
	fi
	if [[ -n $UI ]]; then
		echo "Running User Interface"

		if [[ $rows -lt 43 ]]; then
			echo "Not starting UI. Provided window has $rows rows, minimum is 43" 1>&2
			exit 1
		fi

		if [[ $cols -lt 65 ]]; then
			echo "Not starting UI. Provided window has $cols columns, minimum is 65" 1>&2
			exit 1
		fi

		center_row=$((rows/2))
        	center_col=$((cols/2))
			
		trap cleanup exit

	        tput smcup
       		tput civis

		#This is assuming a 100 starting value
		draw_ui

	fi


	bank=100
	global_deck=( $(draw_deck $NUM_OF_DECKS) )
	while true; do
		if [[ -n $UI ]]; then
			clear_table		
		else
			echo "Starting cash $bank"
		fi

		get_bet bank bet_amount
		if [[ -n $UI ]]; then
			draw_chip_stack $bank
			print_bet $bet_amount
		fi
		game global_deck
		local game_result=$?

		#Bank not updating when I win?
		payout bank bet_amount game_result
		
		
		if [[ -n $UI ]]; then
			draw_chip_stack $bank
		else
			echo "Bank: $bank"
		fi

		if [[ "$bank" -eq "0" ]]; then
			if [[ -n $UI ]]; then
				draw_message "Sorry $USER, you ran out of money. Go home!"
				exit
			else
				echo "Sorry $USER, you ran out of money. Good bye!"
			return 0	
			fi
		fi



	done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
        echo "Running BlackJack"
	main
fi

